{
  "version": "1.0.0",
  "name": "event_radar_sources_config",
  "description": "盘前盘中高敏舆情雷达信源、自发断网检测、进度管理与事件触发门禁配置",
  "network_watchdog": {
    "enabled": true,
    "probe_endpoints": [
      {
        "host": "8.8.8.8",
        "port": 53,
        "provider": "Google_Public_DNS"
      },
      {
        "host": "1.1.1.1",
        "port": 53,
        "provider": "Cloudflare_DNS"
      }
    ],
    "timeout_seconds": 1.5,
    "max_offline_retries": 5,
    "backoff_intervals_seconds": [
      5,
      15,
      30,
      60,
      120
    ]
  },
  "progress_management": {
    "checkpoint_file": "data/ledger/event_radar_checkpoint.json",
    "retention_days": 7,
    "max_hash_history_size": 10000
  },
  "scheduler": {
    "polling_intervals_minutes": {
      "pre_market": 5,
      "regular_market": 15,
      "after_hours": 30,
      "market_closed": 60
    }
  },
  "summary_mode": {
    "type": "unified_model_summary",
    "max_summary_words": 100,
    "enforce_json_schema": true,
    "severity_threshold_for_deep_analysis": [
      "P0",
      "P1"
    ]
  },
  "channels": [
    {
      "channel_id": "sec_8k_disclosures",
      "channel_name": "SEC 8-K 盘前盘中重大突发事件披露",
      "type": "official_regulatory",
      "url": "https://www.sec.gov/edgar/searchedgar/companysearch",
      "priority": "P0"
    },
    {
      "channel_id": "us_federal_and_state_gazette",
      "channel_name": "美国联邦公报与加州/德州重点产业法案跟踪",
      "type": "official_legislative",
      "url": "https://www.federalregister.gov/api/v1/documents.json",
      "priority": "P1"
    },
    {
      "channel_id": "geopolitical_maritime_flash",
      "channel_name": "全球海事与地缘关键咽喉要道突发快讯",
      "type": "public_flash",
      "url": "https://www.ukmto.org/flash-alerts",
      "priority": "P1"
    },
    {
      "channel_id": "port_railway_labor_alerts",
      "channel_name": "美东美西港口工会与铁路物流劳资谈判",
      "type": "labor_logistics",
      "url": "https://www.stb.gov/news-market-data",
      "priority": "P1"
    },
    {
      "channel_id": "antitrust_itc_litigation_tracker",
      "channel_name": "美国司法部/FTC反垄断与ITC 337专利调查排除令",
      "type": "legal_antitrust",
      "url": "https://www.usitc.gov/investigations/337.htm",
      "priority": "P1"
    },
    {
      "channel_id": "physical_commodity_spr_squeeze",
      "channel_name": "战略石油储备(SPR)招标与实物大宗现货倒挂升水",
      "type": "commodity_physical",
      "url": "https://www.energy.gov/ceser/strategic-petroleum-reserve",
      "priority": "P1"
    },
    {
      "channel_id": "central_bank_liquidity_cross_currency",
      "channel_name": "美联储贴现窗口/SRF常备借贷便利与日元套息平仓流动性",
      "type": "central_bank_liquidity",
      "url": "https://www.federalreserve.gov/monetarypolicy/srf.htm",
      "priority": "P0"
    },
    {
      "channel_id": "energy_grid_eia_nerc_alerts",
      "channel_name": "美国EIA/NERC/ERCOT电网负荷与工业限电紧急告警",
      "type": "energy_grid",
      "url": "https://www.eia.gov/electricity/gridmonitor",
      "priority": "P1"
    },
    {
      "channel_id": "cyber_critical_cisa_ics_alerts",
      "channel_name": "美国CISA工控系统与要害基础设施网络瘫痪通报",
      "type": "cyber_infrastructure",
      "url": "https://www.cisa.gov/news-events/cybersecurity-advisories",
      "priority": "P0"
    },
    {
      "channel_id": "biosecurity_fda_congress_tracker",
      "channel_name": "美国国会生物安全法案与FDA进出口扣押警报",
      "type": "biosecurity_embargo",
      "url": "https://www.fda.gov/drugs/regulatory-science-and-research/import-alerts",
      "priority": "P1"
    },
    {
      "channel_id": "critical_minerals_customs_quota",
      "channel_name": "关键战略矿产双用途出口许可证与海外采矿配额",
      "type": "critical_minerals",
      "url": "https://www.usgs.gov/centers/national-minerals-information-center",
      "priority": "P1"
    },
    {
      "channel_id": "defense_procurement_authorization",
      "channel_name": "美国五角大楼NDAA特别军工采购与DSCA对外军售放行",
      "type": "defense_procurement",
      "url": "https://www.defense.gov/News/Contracts",
      "priority": "P1"
    },
    {
      "channel_id": "climate_catastrophe_noaa_alerts",
      "channel_name": "NOAA国家飓风中心气象灾害与沿海关键工业基础设施跳车",
      "type": "climate_insurance",
      "url": "https://www.nhc.noaa.gov",
      "priority": "P1"
    },
    {
      "channel_id": "maritime_insurance_sanctions_tracker",
      "channel_name": "国际保赔协会集团(IG P&I)战险跳涨与海事制裁扣押",
      "type": "maritime_sanctions",
      "url": "https://www.igpandi.org",
      "priority": "P1"
    },
    {
      "channel_id": "sovereign_debt_treasury_liquidity",
      "channel_name": "美国财政部债务上限报告与国债拍卖严重尾部利差",
      "type": "sovereign_debt",
      "url": "https://home.treasury.gov/policy-issues/financing-the-government/quarterly-refunding",
      "priority": "P0"
    }
  ]
}
