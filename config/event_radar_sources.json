{
  "version": "1.0.0",
  "name": "event_radar_sources_config",
  "description": "盘前盘中高敏舆情雷达信源、自发断网检测、进度管理与事件触发门禁配置",
  "network_watchdog": {
    "enabled": true,
    "probe_endpoints": [
      {"host": "8.8.8.8", "port": 53, "provider": "Google_Public_DNS"},
      {"host": "1.1.1.1", "port": 53, "provider": "Cloudflare_DNS"}
    ],
    "timeout_seconds": 1.5,
    "max_offline_retries": 5,
    "backoff_intervals_seconds": [5, 15, 30, 60, 120]
  },
  "progress_management": {
    "checkpoint_file": "data/ledger/event_radar_checkpoint.json",
    "retention_days": 7,
    "max_hash_history_size": 10000
  },
  "scheduler": {
    "polling_intervals_minutes": {
      "pre_market": 5,
      "regular_market": 15,
      "after_hours": 30,
      "market_closed": 60
    }
  },
