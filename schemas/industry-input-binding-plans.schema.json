{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "行业驱动输入绑定方案",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plans"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "plans": {"type": "array", "items": {"$ref": "#/$defs/plan"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["component", "kind", "scope", "unit"],
      "properties": {
        "component": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["numeric", "scope_metadata", "period_metadata"]},
        "scope": {"$ref": "#/$defs/text"},
        "unit": {"$ref": "#/$defs/text"}
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["parent_metric_id", "selected_variant_zh", "definition_reviewed", "requires_same_scope", "slots", "limitations_zh", "period_start", "period_end"],
      "properties": {
        "parent_metric_id": {"$ref": "#/$defs/text"},
        "selected_variant_zh": {"$ref": "#/$defs/text"},
        "definition_reviewed": {"type": "boolean"},
        "requires_same_scope": {"type": "boolean"},
        "slots": {"type": "object", "minProperties": 1, "propertyNames": {"minLength": 1}, "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/binding"}}},
        "limitations_zh": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "period_start": {"type": ["string", "null"], "format": "date"},
        "period_end": {"type": "string", "format": "date"}
      }
    }
  }
}
