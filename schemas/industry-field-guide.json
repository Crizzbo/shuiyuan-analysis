                "S3",
                "S4",
                "S5",
                "S6"
              ]
            },
            "minItems": 6,
            "title": "要求覆盖步骤",
            "description": "六步仍按 S1—S6 执行，本契约不替代 research.schema。",
            "maxItems": 6
          },
          "missing_data_action": {
            "const": "insufficient_evidence",
            "title": "缺资料处理",
            "description": "缺本地数据时返回证据不足，不自动访问外部资料或补零。"
          },
          "real_case_status": {
            "const": "pending_local_data",
            "title": "真实样板状态",
            "description": "当前没有公司观测和真实结论，样板为知识设计填写示例。"
