{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "公司证据数据封套（不等于完整深度研究）",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "symbol", "market", "display_name", "identity_status", "research_status", "facts", "observation_snapshot_path", "driver_snapshot_path", "valuation", "investment_stance", "position_fraction", "unknowns", "limitations"],
  "properties": {
    "schema_version": {"const": "2.0.0"}, "symbol": {"type": "string", "pattern": "^[A-Za-z0-9.\\-]+$"},
    "market": {"enum": ["US", "JP"]}, "display_name": {"type": "string", "minLength": 1},
    "identity_status": {"const": "candidate_label_from_inventory"},
    "research_status": {"enum": ["evidence_partial", "evidence_missing"]},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "observation_snapshot_path": {"type": "string"}, "driver_snapshot_path": {"type": "string"},
    "valuation": {"type": "null"}, "investment_stance": {"type": "null"}, "position_fraction": {"type": "null"},
    "unknowns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "revision", "sha256", "source_path", "available_at", "url", "locator"],
      "properties": {
        "source_id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_path": {"type": "string"},
        "available_at": {"type": "string", "format": "date-time"}, "url": {"type": "string"}, "locator": {"type": "string"}
      }
    },
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "component", "value", "unit", "currency", "period_start", "period_end", "scope", "fact_role", "limitations", "source"],
      "properties": {
        "name": {"type": "string"}, "component": {"type": "string"}, "value": {"type": "string"},
        "unit": {"type": "string"}, "currency": {"enum": ["USD", "JPY", null]},
        "period_start": {"type": ["string", "null"], "format": "date"}, "period_end": {"type": "string", "format": "date"},
        "scope": {"type": "string"}, "fact_role": {"type": "string"}, "limitations": {"type": "string"},
        "source": {"$ref": "#/$defs/source"}
      }
    }
  }
}
