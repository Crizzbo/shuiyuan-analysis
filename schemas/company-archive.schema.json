{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "公司证据档案索引2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "companies_count",
    "companies"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "title": {
      "type": "string"
    },
    "companies_count": {
      "type": "integer",
      "minimum": 1
    },
    "companies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "company_id",
          "ticker",
          "market",
          "profile_path",
          "evidence_path",
          "research_status",
          "investment_stance",
          "position_fraction"
        ],
        "properties": {
          "company_id": {
            "type": "string",
            "minLength": 1
          },
          "ticker": {
            "type": "string",
            "minLength": 1
          },
          "market": {
            "enum": [
              "US",
              "JP"
            ]
          },
          "profile_path": {
            "type": "string",
            "minLength": 1
          },
          "evidence_path": {
            "type": "string",
            "minLength": 1
          },
          "research_status": {
            "enum": [
              "evidence_partial",
              "evidence_missing"
            ]
          },
          "investment_stance": {
            "type": "null"
          },
          "position_fraction": {
            "type": "null"
          }
        }
      }
    }
  }
}
